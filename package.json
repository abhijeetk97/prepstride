{
  "name": "prepstride",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Quiet, cheerful UPSC CSE preparation & timesheet companion with Pip the Stride Bird",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
